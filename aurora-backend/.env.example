# Backend environment variables (copy to .env or export in your shell)
JWT_SECRET=conformidade

# Google OAuth2 Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=

# SMTP settings for email confirmation (optional in dev; falls back to console log if empty)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aurorabookstore.local

# Frontend URL used in email verification links
APP_FRONTEND_URL=http://localhost:5173
